{
  "name": "anatomy-pipeline",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "BodyParts3D -> web-ready GLB pipeline (offline build tool; not part of the app bundle)",
  "scripts": {
    "download": "node scripts/download.mjs .cache/raw",
    "classify": "node scripts/classify.mjs .cache/raw .cache/classification.json .cache/raw/extracted/isa_BP3D_4.0_obj_99,.cache/raw/extracted/partof_BP3D_4.0_obj_99",
    "build": "node --max-old-space-size=8192 scripts/build.mjs --raw .cache/raw --obj .cache/raw/extracted/isa_BP3D_4.0_obj_99,.cache/raw/extracted/partof_BP3D_4.0_obj_99 --lungs-v3 .cache/raw/v3/lungs --out ../../public/models",
    "validate": "node scripts/validate.mjs ../../public/models/body.glb",
    "preview": "node scripts/render-preview.mjs .cache/preview ../../public/models/body.glb"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0"
  }
}
